<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 -0.10"/>
      <geometry><cylinder radius="0.012" length="0.20"/></geometry>
      <material name="matte_dark"/>
    </visual>

    <visual>
      <origin xyz="0 0 -0.005"/>
      <geometry><cylinder radius="0.038" length="0.010"/></geometry>
      <material name="matte_dark"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.012"/>
      <geometry><cylinder radius="0.034" length="0.024"/></geometry>
      <material name="accent_rim"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.035" length="0.002"/></geometry>
      <material name="dusty_pink"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.01"/>
      <geometry><cylinder radius="0.036" length="0.035"/></geometry>
    </collision>
    <inertial>
      <mass value="0.14"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- LiDAR yüksekligi -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.25"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>6.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

</robot>